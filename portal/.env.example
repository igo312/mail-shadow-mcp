# Docker Compose 部署使用。宿主机直接运行见 README「方式 A」。
# Copy to .env and edit.  Never commit .env.
# mcp.example.com is a placeholder; replace it with your real domain or public IP.
MSM_PUBLIC_URL=https://mcp.example.com
MSM_DOMAIN=mcp.example.com
MSM_IMAGE=ghcr.io/dryas/mail-shadow-mcp:latest
# 4 GB host guardrail: at most 100 instances.  Raise only with more RAM.
MSM_MAX_INSTANCES=100
MSM_SECURE_COOKIES=1

# Optional first-run invite.  Remove after creating a real invite.
# MSM_BOOTSTRAP_INVITE=msm_replace_me_with_a_random_code

# Optional: folders to sync (default INBOX; ALL = every folder)
# MSM_SYNC_FOLDERS=INBOX
# Optional: soft-delete target folder
# MSM_TRASH_FOLDER=llm_delete

# Memory profile for ~100 instances on a 4 GB host.
# These are per-container cgroup ceilings, not reservations. Actual usage is
# kept low by GOMEMLIMIT + capped SQLite cache + 256 KB body cap.
MSM_CONTAINER_MEMORY=128m
MSM_CONTAINER_PIDS=128
MSM_CONTAINER_GOMEMLIMIT=48MiB
MSM_CONTAINER_GOGC=50
MSM_CONTAINER_GOMAXPROCS=1
MSM_SYNC_INTERVAL_MIN=30
MSM_SYNC_JITTER_SEC=1800
